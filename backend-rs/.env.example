# Copy to .env for local development. Real environment variables take precedence over this file.
# Production must set every secret explicitly; APP_ENV=dev fills in insecure development defaults.
APP_ENV=dev
# BIND_ADDR=0.0.0.0:8000
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/stowarzysz2
# FRONTEND_URL=http://localhost:5173
# Only when the frontend runs on another origin without the Vite proxy:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of the backend that append to X-Forwarded-For (nginx in production: 1).
# TRUSTED_PROXY_HOPS=1
# LOG_FORMAT=pretty            # pretty | json (default: pretty in dev, json in prod)
# RUST_LOG=info,tower_http=info,sqlx=warn
# MEDIA_ROOT=media

# --- Secrets (required in production) ---
# JWT_SECRET=                  # >= 32 bytes
# MEDIA_SIGNING_KEY=           # >= 32 bytes
# SANTA_SEAL_KEY=              # base64 of exactly 32 random bytes

# --- Web Push (both keys, or neither to disable push) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Receipt OCR (Gemini; all optional) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=      # comma-separated, tried after GEMINI_MODEL on every endpoint
# GEMINI_PRIORITY=false        # try the priority service tier first (paid AI Studio projects)
# GEMINI_INLINE_BUDGET_BYTES=14680064
# Vertex AI candidates (both, or neither):
# VERTEX_PROJECT=
# VERTEX_CREDENTIALS=/run/secrets/vertex.json
# VERTEX_LOCATIONS=global,europe-central2,europe-west4
# OCR_MAX_SIDE=3072
# OCR_DEADLINE=90s
# OCR_HEDGE_AFTER=             # e.g. 20s; empty disables hedged requests

# --- Images ---
# IMAGE_LOSSLESS_EFFORT=4      # libwebp lossless preset, 0 (fast) to 9 (small)

# --- Limits ---
# JSON_BODY_LIMIT_BYTES=1048576
# UPLOAD_LIMIT_BYTES=52428800
# ACTIVATION_TOKEN_TTL=72h
# LOGIN_RATE=10/min
# LOGIN_USERS_RATE=60/min
# ACTIVATION_RATE=10/min
# UPLOAD_RATE=30/min
# OCR_RATE=10/min

# --- One-off import from the Django database (import-django only) ---
# LEGACY_DATABASE_URL=postgres://postgres:postgres@localhost:5434/stowarzysz
# LEGACY_SECRET_KEY=           # Django SECRET_KEY (exchanges SimpleJWT refresh tokens)
# LEGACY_SANTA_KEY=            # Django SECRET_SANTA_KEY (re-seals an active draw)
