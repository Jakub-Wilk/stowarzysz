# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_SANTA_KEY=

# Public address of the app (no trailing slash) and its hostname.
FRONTEND_URL=https://stowarzysz.example.com
ALLOWED_HOSTS=stowarzysz.example.com

# Host port for the web container (put a TLS proxy in front of it).
WEB_PORT=8080

# Web Push (optional): docker compose -f docker-compose.prod.yml run --rm backend python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Receipt OCR (optional): Google AI Studio API key
GEMINI_API_KEY=
